; Native prelogin vertex shader.

.fvec projection[4], modelView[4]

.constf constants(0.0, 1.0, 0.0, 0.0)
.constf inverseByte(0.00392156863, 0.00392156863, 0.00392156863, 0.00392156863)
.alias one constants.y
.alias inverseByteVector inverseByte.xxxx

.out outpos position
.out outclr color
.out outtex texcoord0

.in inpos v0
.in innormal v1
.in incolor v2
.in intex v3

.proc main
  mov r0.xyz, inpos
  mov r0.w, one

  dp4 r1.x, modelView[0], r0
  dp4 r1.y, modelView[1], r0
  dp4 r1.z, modelView[2], r0
  dp4 r1.w, modelView[3], r0

  dp4 outpos.x, projection[0], r1
  dp4 outpos.y, projection[1], r1
  dp4 outpos.z, projection[2], r1
  dp4 outpos.w, projection[3], r1

  mul outclr, inverseByteVector, incolor
  mov outtex, intex
  end
.end
